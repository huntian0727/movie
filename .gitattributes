# Stable cross-platform bytes for release approval hashes.
LICENSE text eol=lf
package-lock.json text eol=lf
build/release-approval.json text eol=lf
scripts/native-source-player-runtime.lock.json text eol=lf
scripts/native-source-media.lock.json text eol=lf
docs/legal/NATIVE-SOURCE-CANDIDATE-REVIEW-INDEX.json text eol=lf
# Preserve the upstream GCC license source byte-for-byte (CRLF in original).
docs/legal/GCC-RUNTIME-LIBRARY-EXCEPTION.txt -text
# Collected upstream texts retain original line endings and whitespace.
docs/legal/NATIVE-SOURCE-CANDIDATE-NOTICES.txt -text -whitespace
docs/legal/FFMPEG-SOURCE-CANDIDATE-LICENSE.txt -text -whitespace

scripts/native-source-inputs.lock.json text eol=lf
build/native-source-approval.json text eol=lf
docs/legal/NATIVE-SOURCE-COMPILED-NOTICES.txt -text -whitespace
docs/legal/NATIVE-SOURCE-COMPILE-REVIEW.json text eol=lf
docs/legal/NATIVE-SOURCE-DISTRIBUTION-REVIEW.md text eol=lf
docs/legal/PUBLIC_TEST_RELEASE_DECISION.md text eol=lf
build/public-test-approval.json text eol=lf
docs/QA/2026-10-12-source-community-sandbox-evidence.json text eol=lf
docs/legal/GNU-GPLv3.txt -text -whitespace
docs/legal/GNU-LGPLv3.txt -text -whitespace

docs/legal/STABLE_PORTABLE_RELEASE_DECISION.md text eol=lf
docs/legal/STABLE_PORTABLE_WINDOWS_QA.json text eol=lf
docs/legal/PORTABLE_RELEASE_QA.json text eol=lf
native/embedded-mpv/NativeHost.cs text eol=lf
# Approval binds the native source archive digest; exclude it from application-source ZIPs to avoid a self-referential hash cycle.
build/release-approval.json export-ignore
# Internal release worklog stays in the repository but is not part of the public application-source archive.
docs/ai/deliveries/2026-10-26-v0.1.17-release.md export-ignore
