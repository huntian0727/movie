{
  "name": "local-video-manager",
  "version": "0.1.12",
  "private": true,
  "main": "dist-main/main/index.js",
  "type": "module",
  "engines": {
    "node": "22.23.1",
    "npm": "10.9.8"
  },
  "packageManager": "npm@10.9.8",
  "volta": {
    "node": "22.23.1",
    "npm": "10.9.8"
  },
  "scripts": {
    "preinstall": "node scripts/verify-environment.mjs",
    "verify:environment": "node scripts/verify-environment.mjs",
    "clean": "node -e \"require('fs').rmSync('dist-main',{recursive:true,force:true})\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "rebuild:electron": "npm run verify:environment && node scripts/rebuild-electron.mjs",
    "prepare:electron": "npm run rebuild:electron && npm run verify:native:electron",
    "dev:electron": "npm run verify:native:electron && node scripts/start-desktop.mjs",
    "verify:native": "npm run verify:native:node",
    "verify:native:node": "npm run verify:environment && node scripts/native-smoke.mjs node",
    "verify:native:electron": "npm run verify:environment && node scripts/run-electron-smoke.mjs --native-only",
    "test:electron-smoke": "npm run verify:environment && node scripts/run-electron-smoke.mjs",
    "test": "npm run test:node",
    "test:node": "npm run verify:native:node && vitest run",
    "test:windows-files": "vitest run tests/main/fileOperations.test.ts tests/main/contentFingerprint.test.ts tests/main/libraryScanner.network.test.ts tests/gates/syntheticLibrary.test.ts",
    "test:migrations": "vitest run tests/main/databaseMigrations.test.ts",
    "test:release-performance": "vitest run tests/gates/performanceBaselines.test.ts tests/main/cacheManager.test.ts tests/main/playerWindow.test.ts",
    "test:release-gate": "npm run lint && npm run build && npm run test:windows-files && npm run test:migrations && npm run test:release-performance && npm run test:node",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "npm run typecheck",
    "build": "npm run clean && tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && vite build",
    "package": "npm run package:dir",
    "package:dir": "npm run build && npm run prepare:electron && node scripts/run-electron-builder.mjs --dir",
    "dist:win": "npm run build && npm run prepare:electron && node scripts/run-electron-builder.mjs --win-nsis",
    "verify:artifact": "node scripts/verify-packaged-artifact.mjs",
    "test:packaged-smoke": "npm run verify:environment && node scripts/run-packaged-smoke.mjs",
    "test:installer-smoke": "npm run verify:environment && node scripts/run-installer-smoke.mjs",
    "release:metadata": "node scripts/write-release-metadata.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "electron-store": "^10.0.0",
    "execa": "^9.5.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electron/asar": "4.2.1",
    "@electron/rebuild": "3.6.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
